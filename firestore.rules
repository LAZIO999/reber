rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.username is string && data.username.size() <= 64 &&
               data.email is string && data.email.size() <= 128 &&
               data.xp is int && data.xp >= 0 &&
               data.streak is int && data.streak >= 0 &&
               data.level is int && data.level >= 1 &&
               data.get('hearts', 5) is int &&
               (data.get('lessonProgress', null) == null || data.lessonProgress is map);
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isEmailVerified() && isValidUser(request.resource.data) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['username', 'photoURL', 'xp', 'streak', 'level', 'hearts', 'lastHeartRefresh', 'lastActive', 'selectedDialect', 'learningLanguage', 'completedLessons', 'lessonProgress']);
    }

    // 2. Courses and Lessons (Public Read, Admin Write)
    match /courses/{courseId} {
      allow read: if isSignedIn();
      
      match /lessons/{lessonId} {
        allow read: if isSignedIn();
      }
    }

    // 3. Words (Public Read)
    match /words/{wordId} {
      allow read: if isSignedIn();
    }

    // 4. Progress (Subcollection)
    match /users/{userId}/progress/{progressId} {
      function isValidProgress(data) {
        return data.lessonId is string && data.lessonId.size() <= 64 &&
               data.status in ['not_started', 'in_progress', 'completed'] &&
               data.get('progress', 0) is number;
      }
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isEmailVerified() && isValidProgress(request.resource.data);
    }

    // 5. Saved Words (Subcollection)
    match /users/{userId}/savedWords/{wordId} {
      function isValidSavedWord(data) {
        return data.wordId is string && data.wordId.size() <= 64 &&
               data.kurdish is string && data.kurdish.size() <= 200 &&
               data.translation is string && data.translation.size() <= 200 &&
               data.savedAt == request.time;
      }
      allow list: if isOwner(userId);
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidSavedWord(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 6. Global Gemini Cache
    match /gemini_cache/{promptHash} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hit_count', 'last_accessed']);
    }
  }
}
