rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── كاش الصوت TTS ───────────────────────────────────────────
    // القراءة: مسموح لأي شخص (الملفات صوتية عامة، لا تحتوي بيانات خاصة)
    // الكتابة: مسموح للمستخدمين المسجلين فقط (لتجنب الإساءة)
    match /tts_cache/{speakerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024  // حد أقصى 5MB
                   && request.resource.contentType.matches('audio/.*');
    }

    // ─── منع الوصول لأي مسار آخر ─────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
